# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Official WhatsApp Community Invite (Shown only to ACCEPTED applicants)
VITE_WHATSAPP_INVITE_URL=https://chat.whatsapp.com/your-community-invite

# Founder Welcome Video Direct CDN (Supabase Storage or Custom CDN)
# If left unset, automatically defaults to: {VITE_SUPABASE_URL}/storage/v1/object/public/videos/founder-welcome.mp4
VITE_FOUNDER_VIDEO_URL=https://your-project.supabase.co/storage/v1/object/public/videos/founder-welcome.mp4