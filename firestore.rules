rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Pioneer Applications: Public can submit and query by application number/email
    match /pioneer_applications/{applicationId} {
      allow read, create: if true;
      allow update, delete: if true; // In production, restrict to staff or admin
    }

    // Contributor Profiles: Public read for verification, authenticated/token update
    match /contributor_profiles/{email} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Squad Tasks / Missions & Bounties: Public can read active missions
    match /squad_tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // Pioneer Proof of Work / Deliverables: Public can submit and read status
    match /pioneer_proof_of_work/{submissionId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Pioneer Certificates: Public can read and verify certificates
    match /pioneer_certificates/{certificateId} {
      allow read: if true;
      allow write: if true;
    }

    // Staff Members: Review team & admin accounts
    match /staff_members/{staffId} {
      allow read, write: if true;
    }

    // Health check ping collection
    match /_health_check/{docId} {
      allow read, write: if true;
    }
  }
}
